PUBLIC_URL=https://YOUR-DOMAIN.example
PORT=3000

TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET

# Start with read-only scopes. Add video.publish only after TikTok approves it.
TIKTOK_SCOPES=user.info.basic,video.list

# Claude custom connector OAuth credentials.
MCP_CLIENT_ID=claude-tiktok
MCP_CLIENT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
